    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.admin-ticket-list__body strong {
    font-size: 0.9rem;
}

.admin-ticket-list__body span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
}

.admin-ticket-list__tags {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
}

.admin-ticket-detail {
    margin-top: 1.5rem;
}

.admin-ticket-message {
    display: flex;
    gap: 0.9rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
}

.admin-ticket-message strong {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.35rem;
}

.admin-ticket-message strong small {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.75rem;
}

.admin-ticket-message p {
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 0.3rem;
}

.admin-ticket-message small {
    color: var(--text-muted);
    font-size: 0.75rem;
}

.admin-ticket-message--internal {
    background: var(--bg);
    border-radius: 8px;
    padding: 1rem;
    border-top: none;
}

.admin-ticket-message--internal p {
    color: var(--text-muted);
}

/* ===================== RESPONSIVO (ADMIN) ===================== */
@media (max-width: 900px) {
    .admin-layout {
        grid-template-columns: 1fr;
    }

    .admin-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .admin-grid {
        grid-template-columns: 1fr;
    }

    .admin-page-head {
        flex-direction: column;
    }

    .admin-mini-stats {
        justify-content: flex-start;
    }

    .admin-panel--flush {
        overflow-x: auto;
    }

    .admin-table--users {
        min-width: 720px;
    }

    .admin-stats--3 {
        grid-template-columns: 1fr;
    }

    .admin-field-grid,
    .admin-field-grid--4 {
        grid-template-columns: 1fr;
    }

    .admin-log-list li {
        flex-direction: column;
    }

    .admin-log-item__meta {
        text-align: left;
    }

    .admin-ticket-list__item {
        flex-wrap: wrap;
    }

    .admin-ticket-list__id {
        width: auto;
    }

    .admin-footbar {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
    }
}

/* ======================================================================== */

header nav a.cabecalho-voltar:last-child {
    background: none;
    color: var(--text-muted);
    padding: 0;
    border-radius: 0;
    font-weight: 500;
    text-transform: none;
}

header nav a.cabecalho-voltar:hover {
    color: var(--text);
}

/* =====================================================
   ÁREA DO CLIENTE — PÁGINA INICIAL 
   ===================================================== */

.cliente-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
}

.cliente-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg);
}

/* ===================== BARRA LATERAL DO CLIENTE ===================== */
.cliente-sidebar {
    background: var(--white);
    border-right: 1px solid var(--border);
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
}

.cliente-sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
}

.cliente-sidebar__brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--white);
    flex-shrink: 0;
}

.cliente-sidebar__brand-icon svg {
    width: 18px;
    height: 18px;
}

.cliente-sidebar__brand strong {
    display: block;
    font-size: 1rem;
}

.cliente-sidebar__brand strong span {
    color: var(--accent);
}

.cliente-sidebar__brand small {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.cliente-nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.cliente-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
}

.cliente-nav a svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.cliente-nav a:hover {
    background: var(--bg);
    color: var(--text);
}

.cliente-nav a.is-active {
    background: #FFF7ED;
    color: var(--accent);
}

.cliente-nav-label {
    margin: 1.25rem 0 0.5rem;
    padding: 0 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.cliente-sidebar__footer {
    margin-top: auto;
    padding-top: 1.5rem;
}

.cliente-safe-box {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: #DCFCE7;
    border-radius: 10px;
    padding: 0.9rem;
    margin-bottom: 0.75rem;
}

.cliente-safe-box svg {
    width: 18px;
    height: 18px;
    color: #16A34A;
    flex-shrink: 0;
    margin-top: 0.1rem;
}

.cliente-safe-box strong {
    display: block;
    font-size: 0.8rem;
    color: #15803D;
}

.cliente-safe-box p {
    font-size: 0.72rem;
    color: #16A34A;
}

.cliente-logout {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--danger);
}

.cliente-logout svg {
    width: 16px;
    height: 16px;
}

/* ===================== TOPO DA ÁREA DO CLIENTE ===================== */
.cliente-topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem 2rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--white);
}

.cliente-topbar h1 {
    font-size: 1.4rem;
}

.cliente-topbar>div>p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.15rem;
}

.cliente-topbar__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
}

.cliente-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
}

.cliente-icon-btn svg {
    width: 20px;
    height: 20px;
}

.cliente-badge-dot {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
