}

.cliente-ticket-card__corpo h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
}

.cliente-ticket-card__corpo p {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
}

.cliente-ticket-card__corpo p svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.cliente-ticket-card__rodape {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
