}

.cliente-topbar__user {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.cliente-topbar__user strong {
    display: block;
    font-size: 0.85rem;
}

.cliente-topbar__user small {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted);
}

.cliente-dot-ok {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16A34A;
}

/* ===================== CONTEÚDO PRINCIPAL ===================== */
.cliente-main {
    padding: 1.75rem 2rem 3rem;
}

.cliente-search-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}

.cliente-search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
}

.cliente-search svg {
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    flex-shrink: 0;
}

.cliente-search input {
    flex: 1;
    border: none;
    outline: none;
    font: inherit;
    background: none;
}

.cliente-filtros-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    border: 1px solid #FDBA74;
    border-radius: 10px;
    background: #FFF7ED;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
}

.cliente-filtros-btn svg {
    width: 16px;
    height: 16px;
}

/* ========================= EVENTO EM DESTAQUE ========================= */
.cliente-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    background: var(--primary);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 2rem;
}

.cliente-hero__info {
    padding: 2rem;
    color: var(--white);
}

.cliente-hero__badge {
    display: inline-block;
    background: var(--accent);
    color: var(--white);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.9rem;
}

.cliente-hero__info h2 {
    font-size: 1.75rem;
    margin-bottom: 0.9rem;
}

.cliente-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
}

.cliente-hero__meta span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #CBD5E1;
}

.cliente-hero__meta svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
}

.cliente-hero__preco {
    margin-bottom: 1.5rem;
}

.cliente-hero__preco small {
    display: block;
    font-size: 0.75rem;
    color: #94A3B8;
    margin-bottom: 0.15rem;
}

.cliente-hero__preco strong {
    font-size: 1.6rem;
}

.cliente-hero__actions {
    display: flex;
    gap: 0.75rem;
}

.cliente-btn-primario {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: var(--white);
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
}

.cliente-btn-primario svg {
    width: 15px;
    height: 15px;
}

.cliente-btn-secundario {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--white);
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
}

.cliente-btn-secundario svg {
    width: 15px;
    height: 15px;
}

.cliente-hero__imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* ===================== INGRESSOS EM DESTAQUE ===================== */
.cliente-destaques__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.25rem;
}

.cliente-destaques__head h2 {
    font-size: 1.15rem;
}

.cliente-destaques__head p {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
}

.cliente-ver-todos {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
}

.cliente-ver-todos svg {
    width: 14px;
    height: 14px;
}

.cliente-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
}

.cliente-ticket-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
}

.cliente-ticket-card__imagem {
    position: relative;
}

.cliente-ticket-card__imagem img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
}

.cliente-ticket-card__badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(15, 23, 42, 0.85);
    color: var(--white);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.cliente-ticket-card__imagem[data-categoria="esporte"] .cliente-ticket-card__badge {
    background: var(--accent);
}

.cliente-ticket-card__corpo {
