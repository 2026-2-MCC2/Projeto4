}

.cliente-ticket-card__rodape small {
    display: block;
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
}

.cliente-ticket-card__rodape strong {
    font-size: 1.05rem;
}

.cliente-btn-detalhes {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--accent);
    color: var(--white);
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.cliente-btn-detalhes svg {
    width: 12px;
    height: 12px;
}

/* ===================== RESPONSIVO (ÁREA DO CLIENTE) ===================== */
@media (max-width: 900px) {
    .cliente-layout {
        grid-template-columns: 1fr;
    }

    .cliente-sidebar {
        border-right: none;
        border-bottom: 1px solid var(--border);
